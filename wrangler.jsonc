{
	"$schema": "node_modules/wrangler/config-schema.json",

	"name": "agentic-inbox",

	"compatibility_date": "2025-11-28",

	"main": "./workers/cleanup.ts",

	"compatibility_flags": [
		"nodejs_compat"
	],

	"observability": {
		"enabled": true
	},

	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"MailboxDO"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"EmailAgent"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"EmailMCP"
			]
		},
		{
			"tag": "v4-delete-agentic-inbox-durable-objects",
			"deleted_classes": [
				"MailboxDO",
				"EmailAgent",
				"EmailMCP"
			]
		}
	]
}
